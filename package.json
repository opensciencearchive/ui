{
  "name": "@opensciencearchive/ui",
  "version": "0.1.0",
  "description": "Design system for Open Science Archive — editorial specification aesthetic",
  "type": "module",
  "main": "./ui/index.css",
  "exports": {
    ".": "./ui/index.css",
    "./tokens": "./ui/tokens/index.css",
    "./tokens/*": "./ui/tokens/*.css",
    "./base": "./ui/base/index.css",
